import 'dart:io';

void main() {
  print("Enter a string:");
  String str = stdin.readLineSync()!;

  String reverse = "";

  for (int i = str.length - 1; i >= 0; i--) {
    reverse += str[i];
  }

  if (str == reverse) {
    print("The string is a palindrome.");
  } else {
    print("The string is not a palindrome.");
  }
}
