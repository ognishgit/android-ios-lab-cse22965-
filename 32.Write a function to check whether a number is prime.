import 'dart:io';

bool isPrime(int n) {
  if (n < 2) {
    return false;
  }

  for (int i = 2; i < n; i++) {
    if (n % i == 0) {
      return false;
    }
  }

  return true;
}

void main() {
  print("Enter a number:");
  int n = int.parse(stdin.readLineSync()!);

  if (isPrime(n)) {
    print("$n is a prime number.");
  } else {
    print("$n is not a prime number.");
  }
}
