import 'dart:io';

void main() {
  print("Enter a number:");
  int num = int.parse(stdin.readLineSync()!);

  int original = num;
  int reverse = 0;

  while (num != 0) {
    int digit = num % 10;
    reverse = reverse * 10 + digit;
    num = num ~/ 10;
  }

  if (original == reverse) {
    print("$original is a palindrome number.");
  } else {
    print("$original is not a palindrome number.");
  }
}
